<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget. NowPlayingWidget draws the pictures and places the views for the widget's size;
     the positions here are for 5 x 3 cells on a phone about 1080 px wide (older Android keeps these). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- no card: the moon (cover) and its orbit, the text and the buttons, on the wallpaper -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <!-- the orbit: progress around the moon -->
    <ProgressBar
        android:id="@+id/ring"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="142dp"
        android:layout_height="142dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="22dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxWidth="2000dp"
        android:maxHeight="2000dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:progress="0"
        android:progressDrawable="@drawable/widget_ring" />

    <ImageView
        android:id="@+id/ring_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:contentDescription="@null" />

    <!-- the bar along the bottom: progress, and tap anywhere on it to seek (seek_zones) -->
    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="307dp"
        android:layout_height="3dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="213dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxWidth="4000dp"
        android:maxHeight="2000dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:progress="0"
        android:progressDrawable="@drawable/widget_bar" />

    <ImageView
        android:id="@+id/bar_star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/seek_zones"
        android:layout_width="307dp"
        android:layout_height="30dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="199dp"
        android:contentDescription="@string/widget_seek"
        android:orientation="horizontal" />

    <Chronometer
        android:id="@+id/elapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="221dp"
        android:fontFamily="@font/manrope_semibold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="#FFA3A8BC"
        android:textSize="11sp" />

    <Chronometer
        android:id="@+id/remain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="221dp"
        android:layout_marginRight="23dp"
        android:fontFamily="@font/manrope_semibold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="#FFA3A8BC"
        android:textSize="11sp" />

    <!-- what the drawn buttons answer to: previous category, previous, play / pause, next, next category -->
    <FrameLayout
        android:id="@+id/hit_prevcat"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="164dp"
        android:layout_marginTop="125dp"
        android:background="@drawable/widget_hit"
        android:contentDescription="@string/widget_prevcat" />

    <FrameLayout
        android:id="@+id/hit_prev"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="195dp"
        android:layout_marginTop="124dp"
        android:background="@drawable/widget_hit"
        android:contentDescription="@string/widget_prev" />

    <FrameLayout
        android:id="@+id/hit_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="227dp"
        android:layout_marginTop="118dp"
        android:background="@drawable/widget_hit"
        android:contentDescription="@string/widget_play" />

    <FrameLayout
        android:id="@+id/hit_next"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="271dp"
        android:layout_marginTop="124dp"
        android:background="@drawable/widget_hit"
        android:contentDescription="@string/widget_next" />

    <FrameLayout
        android:id="@+id/hit_nextcat"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|left"
        android:layout_marginLeft="304dp"
        android:layout_marginTop="125dp"
        android:background="@drawable/widget_hit"
        android:contentDescription="@string/widget_nextcat" />
</FrameLayout>
